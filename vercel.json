{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<slug>[a-z0-9-]+)\\.tortolanistudio\\.com"
        }
      ],
      "destination": "/:slug"
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "(?<slug>[a-z0-9-]+)\\.tortolanistudio\\.com"
        }
      ],
      "destination": "/:slug/:path+"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "*/demo.json",
      "maxDuration": 10
    }
  }
}
